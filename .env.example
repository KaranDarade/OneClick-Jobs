# OneClick Jobs — Production & Local Environment Configuration
# Copy this file to .env.local for local overrides.
# When deploying to Vercel, set these in Project Settings > Environment Variables.
# All API keys are 100% optional — OneClick Jobs runs out of the box with zero external keys!

# Application Base URL (used for canonical URLs, sitemaps, OpenGraph metadata)
NEXT_PUBLIC_APP_URL=https://oneclickjobs.in

# -----------------------------------------------------------------------------
# 1. Jobvetta Provider (Optional)
# -----------------------------------------------------------------------------
# Sign up at https://www.jobvetta.com/dashboard to obtain a free key (50 req/day).
# If omitted, OneClick Jobs uses transparent Demo Fallback mode alongside live ATS feeds.
JOBVETTA_API_KEY=

# -----------------------------------------------------------------------------
# 2. Adzuna Provider (Optional — 250 free requests/day)
# -----------------------------------------------------------------------------
# Register at https://developer.adzuna.com to get an app ID and app key for India job search.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# -----------------------------------------------------------------------------
# 3. Jooble Provider (Optional — Free Partner API)
# -----------------------------------------------------------------------------
# Register at https://jooble.org/api/about/api-jobs.html for a partner API key.
JOOBLE_API_KEY=

# -----------------------------------------------------------------------------
# 4. Apify Provider (Optional — Actor / Dataset Scraping API)
# -----------------------------------------------------------------------------
# Register at https://apify.com to get your API token and default dataset ID.
APIFY_API_TOKEN=
APIFY_DEFAULT_DATASET_ID=

# -----------------------------------------------------------------------------
# 5. Supabase PostgreSQL Persistence (Optional)
# -----------------------------------------------------------------------------
# If configured, synced jobs from all ATS providers are persisted to PostgreSQL.
# If omitted, OneClick Jobs uses an in-memory repository with zero setup required.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# -----------------------------------------------------------------------------
# 6. Google Gemini AI Assistant (Optional)
# -----------------------------------------------------------------------------
# Obtain from https://aistudio.google.com/
# If configured, enables Gemini 2.0 Flash for candidate fit explanations & cover letter generation.
# If omitted, OneClick Jobs falls back automatically to its deterministic rule-based engine.
GEMINI_API_KEY=
