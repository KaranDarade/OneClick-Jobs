# OneClick Jobs — Environment Variables
# Copy this file to .env.local and populate the values.
# NEVER commit your real API keys or secrets to version control.

# Jobvetta REST API Key (50 free requests per UTC day)
# Sign up at https://www.jobvetta.com/dashboard to obtain a free key.
# If omitted or empty, OneClick Jobs runs in transparent Demo Fallback mode.
JOBVETTA_API_KEY=
